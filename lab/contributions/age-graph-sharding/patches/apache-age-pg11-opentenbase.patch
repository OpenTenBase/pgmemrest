diff --git a/src/backend/opentenbase.c b/src/backend/opentenbase.c
new file mode 100644
index 0000000..468d38c
--- /dev/null
+++ b/src/backend/opentenbase.c
@@ -0,0 +1,207 @@
+/* Copyright (c) 2026 gechengfu. SPDX-License-Identifier: Apache-2.0 */
+#include "postgres.h"
+#include "fmgr.h"
+#include "access/xact.h"
+#include "tcop/utility.h"
+#include "commands/sequence.h"
+#include "catalog/pg_type.h"
+#include "miscadmin.h"
+#include "executor/spi.h"
+#include "nodes/makefuncs.h"
+#include "optimizer/planner.h"
+#include "parser/parse_func.h"
+#include "pgxc/pgxc.h"
+#include "pgxc/planner.h"
+#include "pgxc/execRemote.h"
+#include "utils/builtins.h"
+#include "utils/fmgroids.h"
+#include "utils/inval.h"
+
+static planner_hook_type previous_planner;
+void age_otb_init(void);
+void age_otb_fini(void);
+PG_FUNCTION_INFO_V1(age_otb_dispatch);
+PG_FUNCTION_INFO_V1(age_otb_worker);
+
+/* EXECUTE DIRECT normally classifies every SELECT as read-only. AGE writes
+ * through volatile functions, so only our exact worker call needs a write
+ * connection and participation in the coordinator's distributed transaction.
+ */
+static PlannedStmt *
+age_otb_planner(Query *query, int options, ParamListInfo params,
+                int cached_params, bool explain)
+{
+    bool worker = false;
+    PlannedStmt *plan;
+    if (IS_PGXC_LOCAL_COORDINATOR && query->utilityStmt &&
+        IsA(query->utilityStmt, RemoteQuery) && list_length(query->targetList) == 1)
+    {
+        TargetEntry *entry = linitial(query->targetList);
+        Oid args[] = {TEXTOID, TEXTOID, TEXTOID, INT4OID};
+        Oid oid = LookupFuncName(list_make2(makeString("ag_catalog"),
+                                makeString("_age_otb_worker")), 4, args, true);
+        worker = OidIsValid(oid) && IsA(entry->expr, FuncExpr) &&
+                 ((FuncExpr *)entry->expr)->funcid == oid;
+    }
+    if (previous_planner)
+        plan = previous_planner(query, options, params, cached_params, explain);
+    else if (IS_PGXC_LOCAL_COORDINATOR)
+        plan = pgxc_planner(query, options, params, cached_params, explain);
+    else
+        plan = standard_planner(query, options, params);
+    if (worker && IsA(plan->planTree, RemoteQuery))
+    {
+        RemoteQuery *remote = (RemoteQuery *)plan->planTree;
+        remote->read_only = false;
+        remote->exec_nodes->accesstype = RELATION_ACCESS_UPDATE;
+    }
+    return plan;
+}
+
+void age_otb_init(void)
+{
+    previous_planner = planner_hook;
+    planner_hook = age_otb_planner;
+}
+void age_otb_fini(void)
+{
+    planner_hook = previous_planner;
+}
+
+static void require_admin(void)
+{
+    if (!superuser())
+        ereport(ERROR, (errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+                       errmsg("the experimental AGE router requires a superuser")));
+}
+
+/* Copy the scalar result before leaving SPI's memory context. */
+static text *execute_scalar(const char *sql)
+{
+    MemoryContext caller = CurrentMemoryContext;
+    char *value;
+    text *result;
+    int rc;
+    if (SPI_connect() != SPI_OK_CONNECT)
+        elog(ERROR, "AGE SPI connection failed");
+    rc = SPI_execute(sql, false, 0);
+    if (rc != SPI_OK_SELECT || SPI_processed != 1)
+        elog(ERROR, "AGE operation did not return one result (SPI %d)", rc);
+    value = SPI_getvalue(SPI_tuptable->vals[0], SPI_tuptable->tupdesc, 1);
+    if (value == NULL)
+        elog(ERROR, "AGE operation returned a NULL result");
+    MemoryContextSwitchTo(caller);
+    result = cstring_to_text(value);
+    SPI_finish();
+    return result;
+}
+
+Datum age_otb_dispatch(PG_FUNCTION_ARGS)
+{
+    char *node = text_to_cstring(PG_GETARG_TEXT_PP(0));
+    char *op = text_to_cstring(PG_GETARG_TEXT_PP(1));
+    char *graph = text_to_cstring(PG_GETARG_TEXT_PP(2));
+    char *query = text_to_cstring(PG_GETARG_TEXT_PP(3));
+    int width = PG_GETARG_INT32(4);
+    char *remote;
+    char *sql;
+    require_admin();
+    PreventCommandIfReadOnly("AGE graph operation");
+    PreventCommandIfParallelMode("AGE graph operation");
+    if (!IS_PGXC_LOCAL_COORDINATOR)
+        ereport(ERROR, (errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+                       errmsg("call the AGE router on the coordinator")));
+    remote = psprintf("SELECT ag_catalog._age_otb_worker(%s,%s,%s,%d)",
+                      quote_literal_cstr(op), quote_literal_cstr(graph),
+                      quote_literal_cstr(query), width);
+    sql = psprintf("EXECUTE DIRECT ON (%s) %s", quote_identifier(node),
+                   quote_literal_cstr(remote));
+    PG_RETURN_TEXT_P(execute_scalar(sql));
+}
+
+/* AGE's parser requires dollar quoting to recover Cypher source positions.
+ * Choose a delimiter absent from the input, so quotes cannot escape the SQL. */
+static char *quote_cypher(const char *query)
+{
+    unsigned int i = 0;
+    char delimiter[64];
+    do
+    {
+        snprintf(delimiter, sizeof(delimiter), "$age_query_%u$", i++);
+    } while (strstr(query, delimiter) != NULL);
+    return psprintf("%s%s%s", delimiter, query, delimiter);
+}
+
+Datum age_otb_worker(PG_FUNCTION_ARGS)
+{
+    char *op = text_to_cstring(PG_GETARG_TEXT_PP(0));
+    char *graph = text_to_cstring(PG_GETARG_TEXT_PP(1));
+    char *query = text_to_cstring(PG_GETARG_TEXT_PP(2));
+    int width = PG_GETARG_INT32(3);
+    StringInfoData sql;
+    int i;
+    require_admin();
+    PreventCommandIfReadOnly("AGE graph operation");
+    PreventCommandIfParallelMode("AGE graph operation");
+    if (!IS_PGXC_DATANODE)
+        ereport(ERROR, (errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+                       errmsg("the AGE worker must execute on a data node")));
+    if (strlen(graph) == 0 || strlen(graph) >= NAMEDATALEN)
+        ereport(ERROR, (errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+                       errmsg("graph name must contain 1 to 63 bytes")));
+    /* Graph-local lock: one owner DN, independent of which CN routed a call.
+     * A 32-bit hash collision only serializes two graphs; it cannot mix data.
+     * Acquire before parsing Cypher, which can create labels as a side effect.
+     */
+    DirectFunctionCall2(pg_advisory_xact_lock_int4,
+                        Int32GetDatum(0x414745),
+                        DirectFunctionCall1(hashtext, PG_GETARG_DATUM(1)));
+    AcceptInvalidationMessages();
+    initStringInfo(&sql);
+    if (strcmp(op, "create") == 0)
+        appendStringInfo(&sql,
+            "SELECT pg_catalog.json_build_object('created', %s::text)::text "
+            "FROM ag_catalog.create_graph(%s::name)",
+            quote_literal_cstr(graph), quote_literal_cstr(graph));
+    else if (strcmp(op, "drop") == 0)
+        appendStringInfo(&sql,
+            "SELECT pg_catalog.json_build_object('dropped', %s::text)::text "
+            "FROM ag_catalog.drop_graph(%s::name,true)",
+            quote_literal_cstr(graph), quote_literal_cstr(graph));
+    else if (strcmp(op, "cypher") == 0)
+    {
+        if (width < 1 || width > 32)
+            ereport(ERROR, (errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+                           errmsg("result column count must be between 1 and 32")));
+        appendStringInfoString(&sql,
+            "SELECT COALESCE(pg_catalog.json_agg(row_to_json(r)), '[]'::json)::text "
+            "FROM (SELECT ");
+        for (i = 0; i < width; i++)
+            appendStringInfo(&sql, "%spg_catalog.textin(ag_catalog.agtype_out(c%d)) AS c%d", i ? "," : "", i, i);
+        appendStringInfo(&sql, " FROM ag_catalog.cypher(%s::name,%s::cstring) AS t(",
+                         quote_literal_cstr(graph), quote_cypher(query));
+        for (i = 0; i < width; i++)
+            appendStringInfo(&sql, "%sc%d ag_catalog.agtype", i ? "," : "", i);
+        appendStringInfoString(&sql, ")) AS r");
+    }
+    else
+        ereport(ERROR, (errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+                       errmsg("unknown AGE operation")));
+    PG_RETURN_TEXT_P(execute_scalar(sql.data));
+}
+
+/* Graph-local sequence values fit AGE's 48-bit entry id. */
+PG_FUNCTION_INFO_V1(age_otb_nextval);
+Datum age_otb_nextval(PG_FUNCTION_ARGS)
+{
+    Oid sequence = PG_GETARG_OID(0);
+    int128 value;
+    if (!IS_PGXC_DATANODE || !IsLocalSequence(sequence))
+        ereport(ERROR, (errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+                       errmsg("AGE requires a data-node-local sequence")));
+    value = nextval_local(sequence, true);
+    if (value < 1 || value > (((int128)1 << 48) - 1))
+        ereport(ERROR, (errcode(ERRCODE_NUMERIC_VALUE_OUT_OF_RANGE),
+                       errmsg("AGE entry id exceeds 48-bit range")));
+    PG_RETURN_INT64((int64)value);
+}
