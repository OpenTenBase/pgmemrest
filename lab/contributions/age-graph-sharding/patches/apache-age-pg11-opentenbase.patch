diff --git a/src/include/opentenbase_compat.h b/src/include/opentenbase_compat.h
new file mode 100644
index 0000000..41a3200
--- /dev/null
+++ b/src/include/opentenbase_compat.h
@@ -0,0 +1,51 @@
+/* Copyright (c) 2026 gechengfu. SPDX-License-Identifier: Apache-2.0 */
+#ifndef AGE_OPENTENBASE_COMPAT_H
+#define AGE_OPENTENBASE_COMPAT_H
+#include "postgres.h"
+#include "storage/bufmgr.h"
+#include "parser/parse_coerce.h"
+#include "utils/tuplesort.h"
+#include "commands/defrem.h"
+#include "access/heapam.h"
+#include "catalog/pg_constraint_fn.h"
+#include "commands/schemacmds.h"
+#include "commands/tablecmds.h"
+#include "executor/executor.h"
+#include "parser/parse_target.h"
+#include "utils/datetime.h"
+
+#ifndef PGXC
+#error "This adaptation targets OpenTenBase, not stock PostgreSQL"
+#endif
+
+/* OpenTenBase has the newer slot representation and additional executor args. */
+static inline HeapTuple
+age_materialize_slot(TupleTableSlot *slot)
+{
+    ExecMaterializeSlot(slot);
+    return ExecFetchSlotHeapTuple(slot, false, NULL);
+}
+#undef ExecMaterializeSlot
+#define ExecMaterializeSlot(slot) age_materialize_slot(slot)
+
+static inline TupleTableSlot *
+age_store_tuple(HeapTuple tuple, TupleTableSlot *slot, Buffer buffer, bool freeit)
+{
+    if (BufferIsValid(buffer))
+    {
+        Assert(!freeit);
+        return ExecStoreBufferHeapTuple(tuple, slot, buffer);
+    }
+    return ExecStoreHeapTuple(tuple, slot, freeit);
+}
+#define ExecStoreTuple(t,s,b,f) age_store_tuple(t,s,b,f)
+#define InitResultRelInfo(a,b,c,d,e) InitResultRelInfo(a,b,c,d,e,false)
+#define CreateSchemaCommand(a,b,c,d) CreateSchemaCommand(a,b,false,c,d)
+#define RemoveRelations(a) RemoveRelations(a,NULL)
+#define FigureColname(a) FigureColname(a,NULL)
+#define heap_update(a,b,c,d,e,f,g,h) heap_update(a,b,c,d,e,f,g,h,NULL)
+#define can_coerce_type(a,b,c,d) can_coerce_type(a,b,c,d,false)
+#define ChooseRelationName(a,b,c,d,e) ChooseRelationName(a,b,c,d)
+#define tuplesort_begin_datum(a,b,c,d,e,f,g) tuplesort_begin_datum(a,b,c,d,e,g)
+#define QTW_EXAMINE_RTES QTW_EXAMINE_RTES_BEFORE
+#endif
